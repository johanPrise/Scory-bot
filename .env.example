# Scory v2 root environment reference

# API v2
NODE_ENV=development
PORT=3101
DATABASE_URL=postgresql://scory:scory@localhost:5433/scory_v2
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-this-development-secret
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:5173

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret
TELEGRAM_DRY_RUN=true

# Telegram WebApp / frontend
WEB_APP_URL=http://localhost:5173
VITE_API_V2_URL=http://localhost:3101
VITE_API_V2_ENABLED=true

# Migration only. Remove from production after Mongo import is complete.
MONGO_URL=mongodb://localhost:27017/test
