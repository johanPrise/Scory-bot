{
  "name": "scory-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "v2:dev": "pnpm --dir apps/api-v2 dev",
    "v2:start": "pnpm --dir apps/api-v2 start",
    "v2:build": "pnpm --dir apps/api-v2 build",
    "v2:typecheck": "pnpm --dir apps/api-v2 exec tsc --noEmit --pretty false",
    "v2:prisma:generate": "pnpm --dir apps/api-v2 prisma:generate",
    "v2:migration:dry-run": "pnpm --dir apps/api-v2 migration:dry-run",
    "v2:migration:run": "pnpm --dir apps/api-v2 migration:run",
    "v2:compare": "pnpm --dir apps/api-v2 compare:v1-v2",
    "v2:smoke:mobile": "pnpm --dir apps/api-v2 smoke:mobile",
    "v2:smoke:telegram": "pnpm --dir apps/api-v2 smoke:telegram",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:lint": "npm --prefix web run lint",
    "build": "pnpm v2:build && npm --prefix web run build",
    "test": "pnpm v2:typecheck && npm --prefix web run lint"
  }
}
